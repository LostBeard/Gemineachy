@using Gemineachy.Games
@using Gemineachy.Services
@using SpawnDev.SpawnJS.JSObjects
@using System.Text.RegularExpressions
@using File = SpawnDev.SpawnJS.JSObjects.File
@inject GeminiChatService _geminiChatService
@implements IDisposable
<div>
    <UiButton style="@(_extend ? "" : "opacity: 50%;")" OnClick="@(() => _extend = !_extend)">A</UiButton>
    @if (_extend)
    {
        <UiButton OnClick="IntroduceTools">Introduce Tools</UiButton>
        <UiButton OnClick="TestAsyncQueryResponse">Test Queries</UiButton>
        <UiButton OnClick="TestFileAttachment">Test Files</UiButton>
        <UiButton OnClick="@(()=> _checkers = !_checkers)">Play Checkers</UiButton>
        <UiButton style="@(_geminiChatService.ShowToolTraffic ? "" : "opacity: 50%;")"
                   OnClick="@(() => _geminiChatService.ShowToolTraffic = !_geminiChatService.ShowToolTraffic)">
            @(_geminiChatService.ShowToolTraffic ? "Hide tool calls" : "Show tool calls")
        </UiButton>
    }
    <UiDialog @bind-Open="_dialogOpen" Title="Hello from RazorUI">
        This dialog is rendered by SpawnDomRenderer and styled by the adopted RazorUI sheet. Click the backdrop to close.
    </UiDialog>
</div>
@* Non-modal floating game panel - keeps the Gemini chat accessible while playing. Drag by the header. *@
@if (_checkers)
{
    <GamePanel Title="Checkers" OnClose="@(() => _checkers = false)">
        <CheckersBoard />
    </GamePanel>
}

@code {

    bool _extend = false;
    bool _dialogOpen = false;
    bool _checkers = false;

    // Tool dispatch is centralized in GeminiChatService (parse + invoke + reply). Components no
    // longer parse responses themselves - they contribute tools to the registry. See CheckersBoard
    // for the register-on-mount / unregister-on-unmount pattern.

    /// <summary>Re-send the full tool manifest to Gemini (protocol instructions + tool schemas).</summary>
    async Task IntroduceTools()
    {
        await _geminiChatService.SendToolInfo();
    }
    /// <summary>
    /// Send agent queries and wait for the response
    /// </summary>
    /// <returns></returns>
    async Task TestAsyncQueryResponse()
    {
        var resp = await _geminiChatService.Query("Hello!");
        Console.WriteLine($"[RazorRendererDemo] hello response: {resp}");
        resp = await _geminiChatService.Query("Do you like c#?");
        Console.WriteLine($"[RazorRendererDemo] c# response: {resp}");
    }
    /// <summary>
    /// Send a message with file attachments
    /// </summary>
    /// <returns></returns>
    async Task TestFileAttachment()
    {
        var files = new List<File>();
        for(var i = 1; i < 12; i++)
        {
            var file = new File([$"Hellow world #{i}! This is in file: 'myfile_{i}.txt'"], $"myfile_{i}.txt", new FileOptions { Type = "text/plain" });
            files.Add(file);
        }
        await _geminiChatService.Query($"This is a test of programmatic file attachment. Trying to verify the attachment of {files.Count} files.", files);
    }
    public void Dispose()
    {
    }
}

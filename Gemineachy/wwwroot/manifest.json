{
  "manifest_version": 3,
  "name": "Gemineachy",
  "version": "1.2",
  "description": "Gemineachy acts as a secure, local bridge between the cloud chat interface and the user's local execution environment, hardware, and rendering engine to provide avatars and local tools.",
  "icons": {
    "128": "app/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://duck.ai/*",
    "https://chatgpt.com/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "http://*.local/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://duck.ai/*",
        "https://chatgpt.com/*",
        "https://chat.z.ai/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "app/content.js"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "include_globs": [
        "*udm=50*"
      ],
      "js": [
        "app/content.js"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "https://chat.z.ai/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "app/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://duck.ai/*",
        "https://chatgpt.com/*",
        "https://chat.z.ai/*",
        "https://chat.qwen.ai/*",
        "https://www.google.com/*"
      ],
      "resources": [
        "app/*"
      ]
    }
  ]
}

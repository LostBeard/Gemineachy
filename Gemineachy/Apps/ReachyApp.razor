@using Gemineachy.Desktop
@using Gemineachy.Services.Reachy
@attribute [App(Name = "Reachy", Icon = "🤖", Pinned = true, SingleInstance = true, Description = "Connect and control Reachy Mini robots")]
@inherits AppBase
@inject ReachyService Reachy
@inject SpeechService Speech

<div class="reachy-app">
    <div class="reachy-section">
        <div class="reachy-title">Robots</div>
        @if (Reachy.Robots.Count == 0)
        {
            <div class="reachy-empty">No robots configured. Add one below - the default Reachy Mini is at reachy-mini.local.</div>
        }
        else
        {
            @foreach (var r in Reachy.Robots)
            {
                <div class="robot-card">
                    <div class="robot-head">
                        <span class="robot-dot @(r.Online ? "on" : "off")"></span>
                        <span class="robot-name">@r.Name</span>
                        <span class="robot-origin">@r.Origin</span>
                        <span class="robot-status">@r.Status</span>
                        <button class="reachy-btn remove" @onclick="() => Remove(r.Name)">✕</button>
                    </div>
                    <div class="robot-controls">
                        <button class="reachy-btn" @onclick="() => Do(() => Reachy.RefreshStatusAsync(r.Name))">Status</button>
                        <button class="reachy-btn" @onclick="() => Do(() => Reachy.ManualWakeAsync(r.Name))">Wake</button>
                        <button class="reachy-btn" @onclick="() => Do(() => Reachy.ManualSleepAsync(r.Name))">Sleep</button>
                        <button class="reachy-btn" @onclick="() => Do(() => Reachy.ManualStopAsync(r.Name))">Stop</button>
                        <button class="reachy-btn" title="Enable motors (required to move)" @onclick="() => Do(() => Reachy.ManualMotorsAsync(r.Name, true))">⚡On</button>
                        <button class="reachy-btn" title="Rest to sleep pose, then disable motors (safe limp - won't drop)" @onclick="() => Do(() => Reachy.ManualMotorsAsync(r.Name, false))">⚡Off</button>
                        <span class="ctrl-sep"></span>
                        <button class="reachy-btn" title="Look up" @onclick="() => Do(() => Reachy.ManualHeadAsync(r.Name, 0.3, 0))">↑</button>
                        <button class="reachy-btn" title="Look down" @onclick="() => Do(() => Reachy.ManualHeadAsync(r.Name, -0.3, 0))">↓</button>
                        <button class="reachy-btn" title="Look left" @onclick="() => Do(() => Reachy.ManualHeadAsync(r.Name, 0, 0.4))">←</button>
                        <button class="reachy-btn" title="Look right" @onclick="() => Do(() => Reachy.ManualHeadAsync(r.Name, 0, -0.4))">→</button>
                        <button class="reachy-btn" title="Center head" @onclick="() => Do(() => Reachy.ManualHeadAsync(r.Name, 0, 0))">◎</button>
                        <button class="reachy-btn" title="Wiggle antennas" @onclick="() => Do(() => Reachy.ManualAntennasAsync(r.Name, 0.8, 0.8))">📡</button>
                        <span class="ctrl-sep"></span>
                        <button class="reachy-btn" title="Act out a sample stage direction, the same path Gemini's replies take" @onclick="() => Report(() => Reachy.PerformFromTextAsync(SampleLine, r.Name))">🎭 Test gesture</button>
                        <button class="reachy-btn" title="One-shot: connect the audio link, listen for 8 seconds, and transcribe what the robot heard" @onclick="() => Report(() => Reachy.RunSpeechSelfTestAsync(r.Name))">🗣 Test STT</button>
                        <button class="reachy-btn" title="Transcribe a known speech recording shipped with the extension - proves the STT pipeline without needing anyone to talk" @onclick="() => Report(() => Speech.RunSelfTestAsync())">🧪 STT self-test</button>
                        <button class="reachy-btn" title="Listen for 6 seconds, transcribe what the robot heard, and send it to Gemini as a chat message. Turn on 'act out replies' and the robot answers physically." @onclick="() => Report(() => Reachy.ListenAndAskGeminiAsync(r.Name))">💬 Listen and ask Gemini</button>
                        <span class="ctrl-sep"></span>
                        <button class="reachy-btn" title="Check the WebRTC signalling link (ws://:8443 via the background worker) and list what the robot is publishing" @onclick="() => Report(() => Reachy.TestSignalingAsync(r.Name))">🔊?</button>
                        @if (r.AudioConnected)
                        {
                            <button class="reachy-btn" title="Stop listening and close the WebRTC audio link" @onclick="() => Report(() => Reachy.DisconnectAudioAsync(r.Name))">🔇 Stop listening</button>
                            @if (r.MicSending)
                            {
                                <button class="reachy-btn" title="Stop sending your microphone to the robot" @onclick="() => Report(() => Reachy.StopTalkingAsync(r.Name))">🎙 Stop talking</button>
                            }
                            else
                            {
                                <button class="reachy-btn" title="Send your microphone to the robot's speaker so you can talk to it" @onclick="() => Report(() => Reachy.StartTalkingAsync(r.Name))">🎤 Talk</button>
                            }
                            @if (r.EarsOn)
                            {
                                <button class="reachy-btn" title="Transcribe the last 10 seconds the robot heard - talk first, then press this" @onclick="() => Report(() => Reachy.TranscribeRecentAsync(r.Name))">🗣 Transcribe last 10s</button>
                                <button class="reachy-btn" title="Stop keeping a rolling window of the microphone" @onclick="() => Report(() => Task.FromResult(Reachy.StopEars(r.Name)))">👂 Ears off</button>
                            }
                            else
                            {
                                <button class="reachy-btn" title="Keep a rolling 30s window of the robot's microphone so any recent moment can be transcribed" @onclick="() => Report(() => Task.FromResult(Reachy.StartEars(r.Name)))">👂 Ears on</button>
                            }
                            <span class="robot-status">audio: @r.AudioState</span>
                        }
                        else
                        {
                            <button class="reachy-btn" title="Open the WebRTC audio link and play the robot's microphone here" @onclick="() => Report(() => Reachy.ConnectAudioAsync(r.Name))">🔈 Listen</button>
                        }
                    </div>
                    @if (ReachyService.NeedsHostPermission(r.Host))
                    {
                        <div class="robot-note">IP/custom host - if commands fail, the extension may need host access granted for @r.Origin.</div>
                    }
                </div>
            }
        }
    </div>

    <div class="reachy-add">
        <input class="reachy-input name" placeholder="name (optional)" @bind="_name" @bind:event="oninput" />
        <input class="reachy-input host" placeholder="reachy-mini.local or 192.168.1.x" @bind="_host" @bind:event="oninput" />
        <input class="reachy-input port" placeholder="8000" @bind="_port" @bind:event="oninput" />
        <button class="reachy-btn add" @onclick="Add" disabled="@_busy">+ Add robot</button>
    </div>
    <div class="reachy-add">
        @if (Reachy.AnimateFromChat)
        {
            <button class="reachy-btn" title="Stop acting out Gemini's replies" @onclick="() => Report(() => Reachy.SetAnimateFromChatAsync(false))">🎭 Acting out Gemini's replies - stop</button>
        }
        else
        {
            <button class="reachy-btn" title="Let Gemini animate the robot: it writes *stage directions* inline and the robot performs them" @onclick="() => Report(() => Reachy.SetAnimateFromChatAsync(true))">🎭 Let Gemini animate the robot</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="reachy-statusline">@_status</div>
    }

    <div class="reachy-section">
        <div class="reachy-title">Recent agent activity</div>
        @if (Reachy.RecentActions.Count == 0)
        {
            <div class="reachy-empty">Nothing yet. When Gemini drives a robot (WakeUp, MoveHead, …) it appears here.</div>
        }
        else
        {
            <div class="reachy-activity">
                @foreach (var a in Reachy.RecentActions.Take(8))
                {
                    <div class="activity-row">
                        <span class="activity-tool">@a.Tool</span>
                        <span class="activity-robot">@a.Robot</span>
                        <span class="activity-result">@a.Result</span>
                        <span class="activity-time">@a.Time.ToString("HH:mm:ss")</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="reachy-footer">Gemini can drive these robots with the Reachy tools · a shared robot is a machine-to-machine bridge</div>
</div>

@code {
    private bool _busy;
    private string? _status;
    private string _name = "";
    private string _host = "reachy-mini.local";
    private string _port = "8000";

    /// <summary>Exercises the exact path a Gemini reply takes: split off the stage direction, classify it,
    /// perform it. Two directions so the queueing behaviour is visible, not just a single twitch.</summary>
    private const string SampleLine = "*tilts head curiously* Hello there! *antennas perk up* Ready when you are.";

    protected override async Task OnInitializedAsync()
    {
        Reachy.OnChanged += OnChanged;
        await Reachy.Ready;
        await Reachy.RefreshStatusAsync();
        // Opening the Reachy app signals intent to control robots, so let Gemini know it can (introduces
        // the tool manifest the first time).
        await Reachy.AnnounceRobotsAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Add()
    {
        await Run(async () =>
        {
            int port = int.TryParse(_port, out var p) ? p : 8000;
            _status = await Reachy.AddRobotAsync(_name, _host, port);
            _name = "";
        });
    }

    private async Task Remove(string name) => await Run(async () =>
    {
        await Reachy.RemoveRobotAsync(name);
        _status = $"Removed '{name}'.";
    });

    // Manual control buttons: fire the action and surface any failure in the status line.
    private async Task Do(Func<Task> action) => await Run(action);

    // Same, for an action whose RESULT is the point - it becomes the status line.
    private async Task Report(Func<Task<string>> action) => await Run(async () => _status = await action());

    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await action(); }
        catch (Exception ex) { _status = ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    protected override void OnDispose() => Reachy.OnChanged -= OnChanged;
}
